{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "numReplicas": 1,
    "startCommand": "python scripts/aegis_monitor_schedule.py",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 1,
    "cronSchedule": "0 6 * * *"
  }
}
