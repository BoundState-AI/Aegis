{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "numReplicas": 1,
    "startCommand": "uvicorn boundstate_aegis.api.aegis_api:app --host 0.0.0.0 --port ${PORT:-8002}",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 60
  }
}
